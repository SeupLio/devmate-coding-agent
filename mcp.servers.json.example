{
  "_说明": "复制为 mcp.servers.json 即可让 DevMate 在运行时接入外部 MCP 服务器；也可用环境变量 MCP_SERVERS（JSON 数组）注入。",
  "_示例": "下面的 devmate-demo 是仓库自带的演示服务器，暴露 get_time / word_count / sha256 三个工具。",
  "servers": [
    {
      "name": "demo",
      "command": "bun",
      "args": ["scripts/mcp-demo-server.ts"],
      "timeoutMs": 15000
    }
  ]
}
