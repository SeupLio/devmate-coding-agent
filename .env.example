# DevMate 配置文件示例：复制为 .env 后填写真实值（.env 已被 .gitignore 忽略）
#
# === LLM 提供方选择 ===
# LLM_PROVIDER=openai 时使用任意 OpenAI 兼容接口（DeepSeek / 通义 / OpenAI 官方 / vLLM 等）
# LLM_PROVIDER=zai    时使用智谱清言内部 SDK（仅在智谱沙箱环境内有凭证时可用）
LLM_PROVIDER=openai

# === OpenAI 兼容配置 ===
# OPENAI_BASE_URL 默认 https://api.openai.com/v1
# DeepSeek 示例：https://api.deepseek.com
# 通义 DashScope 兼容模式：https://dashscope.aliyuncs.com/compatible-mode/v1
# 智谱开放平台（GLM-4-Flash 免费）：https://open.bigmodel.cn/api/paas/v4
OPENAI_BASE_URL=https://open.bigmodel.cn/api/paas/v4
OPENAI_API_KEY=请填入你的密钥
OPENAI_MODEL=glm-4-flash